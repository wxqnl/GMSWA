{
  "architectures": [
    "GSAForCausalLM"
  ],
  "bos_token_id": 1,
  "eos_token_id": 2,
  "elementwise_affine": true,
  "expand_k": 1.0,
  "expand_v": 1.0,
  "feature_map": "swish",
  "fuse_cross_entropy": true,
  "fuse_linear_cross_entropy": false,
  "fuse_norm": true,
  "fuse_swiglu": true,
  "gate_logit_normalizer": 8,
  "hidden_act": "swish",
  "hidden_ratio": 4,
  "hidden_size": 640,
  "initializer_range": 0.02,
  "intermediate_size": 3328,
  "max_position_embeddings": 32768,
  "model_type": "gsa",
  "norm_eps": 1e-06,
  "num_heads": 10,
  "num_hidden_layers": 12,
  "num_kv_heads": 2,
  "num_slots": 16,
  "tie_word_embeddings": true,
  "torch_dtype": "bfloat16",
  "transformers_version": "4.43.1",
  "use_cache": true,
  "use_l2warp": false,
  "use_norm": true,
  "use_output_gate": true,
  "use_short_conv": false,
  "conv_size": 4,
  "vocab_size": 32000
}
