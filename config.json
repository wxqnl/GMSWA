{
  "architectures": [
    "GatedMemSWAForCausalLM"
  ],
  "bos_token_id": 1,
  "eos_token_id": 2,
  "hidden_act": "swish",
  "hidden_size": 640,
  "initializer_range": 0.02,
  "intermediate_size": 3328,
  "hidden_ratio": 4,
  "qkv_bias": true,
  "max_position_embeddings": 32768,
  "model_type": "gated_mem_swa",
  "num_heads": 10,
  "num_hidden_layers": 12,
  "num_kv_heads": 2,
  "norm_eps": 1e-06,
  "rope_theta": 1000000.0,
  "window_size": 128,
  "disable_memory": false,
  "mem_gate_logit_bias": -2.0,
  "mix_gate_logit_bias": 4.0,
  "a_log_init_lo": 1.0,
  "a_log_init_hi": 16.0,
  "dt_min": 0.001,
  "dt_max": 0.1,
  "dt_init_floor": 0.0001,
  "tie_word_embeddings": true,
  "torch_dtype": "bfloat16",
  "transformers_version": "4.57.0",
  "use_cache": true,
  "fuse_norm": true,
  "fuse_swiglu": true,
  "fuse_cross_entropy": true,
  "fuse_linear_cross_entropy": false,
  "_attn_implementation": "flash_attention_2",
  "use_l2warp": false,
  "vocab_size": 32000
}
