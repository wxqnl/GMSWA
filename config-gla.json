{
  "architectures": [
    "GLAForCausalLM"
  ],
  "bos_token_id": 1,
  "eos_token_id": 2,
  "hidden_act": "swish",
  "hidden_size": 896,
  "initializer_range": 0.02,
  "intermediate_size": 4864,
  "hidden_ratio": 4,
  "max_position_embeddings": 32768,
  "model_type": "gla",
  "num_heads": 14,
  "num_hidden_layers": 24,
  "num_kv_heads": 2,
  "norm_eps": 1e-06,
  "attn_mode": "chunk",
  "expand_k": 0.5,
  "expand_v": 1.0,
  "feature_map": null,
  "use_short_conv": false,
  "conv_size": 4,
  "use_output_gate": true,
  "clamp_min": null,
  "elementwise_affine": true,
  "use_gk": true,
  "use_gv": false,
  "use_cache": true,
  "tie_word_embeddings": true,
  "fuse_norm": true,
  "fuse_swiglu": true,
  "fuse_cross_entropy": true,
  "fuse_linear_cross_entropy": false,
  "use_l2warp": false,
  "vocab_size": 32000
}
