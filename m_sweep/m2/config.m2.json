{
  "architectures": [
    "GatedMemSWAForCausalLM"
  ],
  "bos_token_id": 1,
  "eos_token_id": 2,
  "hidden_act": "swish",
  "hidden_size": 640,
  "initializer_range": 0.02,
  "intermediate_size": 3328,
  "hidden_ratio": 4,
  "qkv_bias": true,
  "max_position_embeddings": 32768,
  "model_type": "gated_mem_swa",
  "num_heads": 10,
  "num_hidden_layers": 12,
  "num_kv_heads": 2,
  "norm_eps": 1e-06,
  "rope_theta": 1000000.0,
  "mem_scale": 1.0,
  "mem_proj_mode": "linear",
  "mem_gate_mode": "linear",
  "mem_update_stride": 1,
  "gate_bias_init": 1.0,
  "mem_norm": true,
  "mem_norm_eps": 1e-06,
  "window_size": 128,
  "tie_word_embeddings": true,
  "torch_dtype": "bfloat16",
  "transformers_version": "4.43.1",
  "use_cache": true,
  "fuse_norm": true,
  "fuse_swiglu": true,
  "fuse_cross_entropy": true,
  "fuse_linear_cross_entropy": false,
  "_attn_implementation": "flash_attention_2",
  "use_l2warp": false,
  "vocab_size": 32000,
  "num_mem_slots": 2
}
